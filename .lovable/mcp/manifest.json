{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://xfgcndntkweijojfbyit.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "urban-print-platform",
      "version": "0.1.0",
      "title": "Urban Print Platform"
    },
    "tools": [
      {
        "name": "list_categories",
        "title": "Listar categorías",
        "description": "Lista las categorías y subcategorías del catálogo público de Urban Print.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "parent_slug": {
              "description": "Slug de la categoría padre para listar solo sus subcategorías.",
              "type": "string",
              "maxLength": 120
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "search_products",
        "title": "Buscar productos",
        "description": "Busca productos del catálogo público de Urban Print por texto y, opcionalmente, por slug de categoría.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Texto a buscar en nombre o descripción.",
              "type": "string",
              "maxLength": 120
            },
            "category_slug": {
              "description": "Slug de categoría para filtrar.",
              "type": "string",
              "maxLength": 120
            },
            "limit": {
              "default": 20,
              "description": "Número máximo de resultados.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Ver producto",
        "description": "Devuelve el detalle de un producto público de Urban Print a partir de su slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "description": "Slug del producto."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_my_orders",
        "title": "Mis pedidos",
        "description": "Lista los pedidos del usuario autenticado en Urban Print.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 10,
              "description": "Número máximo de pedidos.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_order",
        "title": "Ver pedido",
        "description": "Devuelve el detalle y las líneas de un pedido del usuario autenticado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "order_number": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "description": "Número del pedido."
            }
          },
          "required": [
            "order_number"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
